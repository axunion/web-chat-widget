# Copy to .env and fill in. The key stays here, server-side — never in the browser.
OPENAI_API_KEY=sk-...

# Optional. Any OpenAI-compatible endpoint works (Azure OpenAI, OpenRouter,
# a local llama.cpp / Ollama server, etc.).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional. Injected server-side as the system message; client-sent system
# messages are dropped when this is set. The system prompt is trusted input —
# keep it here, not in page markup.
SYSTEM_PROMPT=

# Lock this down to your real site's origin in production. "*" is dev-only.
ALLOWED_ORIGIN=*

PORT=8787
