{
  "name": "web-chat-widget",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "warn"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/chat-widget.iife.js",
  "jsdelivr": "./dist/chat-widget.iife.js",
  "sideEffects": [
    "./dist/element.js",
    "./dist/chat-widget.iife.js"
  ],
  "files": [
    "dist",
    "!dist/*.html"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters.js"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "prepack": "pnpm build",
    "dev": "vite",
    "build": "vite build && vite build --mode iife && tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs && node scripts/copy-demo.mjs",
    "typecheck": "tsc",
    "preview": "vite preview",
    "demo": "pnpm build && pnpm preview",
    "check": "biome check ./src",
    "fix": "biome check --write ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "happy-dom": "^20.9.0",
    "lefthook": "^2.1.9",
    "playwright": "^1.49.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  }
}